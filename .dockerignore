# ──────────────────────────────────────────────────────────
# .dockerignore — Exclude files from Docker build context
# ──────────────────────────────────────────────────────────

# Dependencies
node_modules

# Next.js build artifacts
.next
out

# Git
.git
.gitignore

# Environment files (secrets — never in image)
.env
.env.*
!.env.local.example

# Documentation
docs/
openspec/
*.md
!package.json

# IDE / Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Dev tools
.atl/
.codegraph/
.playwright-mcp/
.stitch-screens/
.vercel

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Turbopack generated
src/**/*.js

# Docker files (avoid recursive copy)
Dockerfile
docker-compose*.yml
.dockerignore

# Monitoring (separate build context)
monitoring/
