    ".turbo/**"
  ],
  "patterns": [
    {
      "name": "latex-inline",
      "pattern": "\\$[^$\\n]+?\\$"
    },
    {
      "name": "latex-block",
      "pattern": "\\$\\$[\\s\\S]*?\\$\\$"
    },
    {
      "name": "code-fence",
      "pattern": "```[\\s\\S]*?```"
    },
    {
      "name": "inline-code",
      "pattern": "`[^`]*?`"
    },
    {
      "name": "dna-sequence",
      "pattern": "\\b[ATGC]{4,}\\b"
    }
  ],
  "ignoreRegExpList": [
    "latex-inline",
    "latex-block",
    "code-fence",
    "inline-code",
    "dna-sequence"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "locale": "es,en",
      "dictionaries": [
        "es-es",
        "en_us",
        "softwareTerms",
        "python"
      ],
      "caseSensitive": false
    }
  ]
