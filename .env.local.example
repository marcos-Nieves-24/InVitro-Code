# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGNING_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for internal server-to-server fetch in admin/profile actions)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Certification (E2B sandbox) — feature flag, default OFF.
# Keep it off until E2B is integrated; with off, /api/certify rejects (503)
# and the UI hides the certification button (REQ-CER-01/05).
FEATURE_FLAG_CERTIFY=false
