# El editor Monaco se carga desde CDN.
#
# `@monaco-editor/react` declara `monaco-editor` como peer dependency, pero el
# codigo usa `@monaco-editor/loader` en su configuracion por defecto, que baja
# Monaco desde jsdelivr en runtime. El paquete npm no se instala, y no debe
# instalarse: seria sumar ~90 MB al bundle por algo que ya baja el CDN.
#
# Sin esto, `npm ci` falla con:
#   npm ci can only install packages when your package.json and
#   package-lock.json are in sync.
#   Missing: monaco-editor@0.57.0 from lock file
# El npm 10 lo reporta como un crash confuso
# ("Cannot read properties of null (reading 'edgesOut')") en vez del mensaje real.
legacy-peer-deps=true
